{
  "name": "supernote-typescript",
  "version": "0.2.4",
  "description": "Supernote file-format support.",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -f tests/output/*.png tests/output/*.jpg tests/output/*.cpuprofile",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-mirror": "vitest --watch -t mirror",
    "coverage": "vitest run --coverage",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philips/supernote-typescript.git"
  },
  "keywords": [
    "supernote",
    "typescript",
    "library"
  ],
  "author": "Brandon Philips",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/philips/supernote-typescript/issues"
  },
  "homepage": "https://gitlab.com/philips/supernote-typescript",
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.1",
    "eslint-plugin-node": "11.1.0",
    "prettier": "3.9.6",
    "typescript": "4.9.5",
    "vitest": "1.6.1"
  },
  "dependencies": {
    "color": "^5.0.3",
    "fs-extra": "^11.4.0",
    "image-js": "^1.7.0"
  }
}
